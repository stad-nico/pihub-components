{
	"singleQuote": true,
	"trailingComma": "es5",
	"useTabs": true,
	"tabWidth": 4,
	"printWidth": 140,
	"singleAttributePerLine": false,
	"endOfLine": "lf",
	"overrides": [
		{
			"files": ["*.html"],
			"options": {
				"parser": "angular"
			}
		},
		{
			"files": ["*.md"],
			"options": {
				"printWidth": 180
			}
		}
	]
}
