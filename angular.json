{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"newProjectRoot": "projects",
	"schematics": {
		"@schematics/angular:component": {
			"style": "scss",
			"skipTests": true,
			"displayBlock": true,
			"changeDetection": "OnPush"
		},
		"@schematics/angular:service": {
			"skipTests": true
		}
	},
	"projects": {
		"@pihub/components": {
			"projectType": "library",
			"root": "projects/pihub/components",
			"sourceRoot": "projects/pihub/components/src",
			"prefix": "pihub",
			"architect": {
				"build": {
					"builder": "@angular/build:ng-packagr",
					"options": {
						"project": "projects/pihub/components/ng-package.json"
					},
					"configurations": {
						"production": {
							"tsConfig": "projects/pihub/components/tsconfig.pihub.prod.json"
						},
						"development": {
							"tsConfig": "projects/pihub/components/tsconfig.pihub.json"
						}
					},
					"defaultConfiguration": "production"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"tsConfig": "projects/pihub/components/tsconfig.spec.json",
						"polyfills": ["zone.js", "zone.js/testing"]
					}
				}
			}
		},
		"@pihub/documentation": {
			"projectType": "application",
			"root": "projects/pihub/documentation",
			"sourceRoot": "projects/pihub/documentation/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@ng-doc/builder:application",
					"options": {
						"outputPath": "dist/documentation",
						"index": "projects/pihub/documentation/src/index.html",
						"browser": "projects/pihub/documentation/src/main.ts",
						"polyfills": ["zone.js"],
						"tsConfig": "projects/pihub/documentation/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "node_modules/@ng-doc/app/assets",
								"output": "assets/ng-doc/app"
							},
							{
								"glob": "**/*",
								"input": "node_modules/@ng-doc/ui-kit/assets",
								"output": "assets/ng-doc/ui-kit"
							},
							{
								"glob": "**/*",
								"input": "ng-doc/@pihub/documentation/assets",
								"output": "assets/ng-doc"
							},
							{
								"glob": "**/*",
								"input": "projects/pihub/documentation/assets",
								"output": "assets"
							},
							{
								"glob": "**/*",
								"input": "projects/pihub/components/assets",
								"output": "assets"
							}
						],
						"styles": [
							"node_modules/@ng-doc/app/styles/global.css",
							"projects/pihub/components/assets/styles/styles.scss",
							"projects/pihub/documentation/src/ng-doc.scss"
						],
						"scripts": [],
						"allowedCommonJsDependencies": ["@ng-doc/core"]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "1MB",
									"maximumError": "5MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all",
							"baseHref": "./"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@ng-doc/builder:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "documentation:build:production"
						},
						"development": {
							"buildTarget": "@pihub/documentation:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"extract-i18n": {
					"builder": "@angular-devkit/build-angular:extract-i18n"
				},
				"test": {
					"builder": "@angular-devkit/build-angular:karma",
					"options": {
						"polyfills": ["zone.js", "zone.js/testing"],
						"tsConfig": "projects/pihub/documentation/tsconfig.spec.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "projects/pihub/documentation/assets",
								"output": "assets"
							}
						],
						"styles": ["projects/pihub/documentation/src/styles.scss"],
						"scripts": []
					}
				}
			}
		}
  },
  "cli": {
    "analytics": "e926bda3-cc18-4f75-b4ec-33e8cfc8edf6"
  }
}
